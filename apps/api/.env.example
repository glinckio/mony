PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/mony"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="no-reply@mony.app"
BREVO_SENDER_NAME="Mony"

# Object storage for vehicle photos (MinIO, S3-compatible). Unset in dev =
# in-memory storage (photos don't persist); required in production, where
# both endpoints must be https://.
#
# Dev container (from Git Bash keep MSYS_NO_PATHCONV=1, or "/data" gets
# rewritten to a Windows path and the volume is silently unused):
#   MSYS_NO_PATHCONV=1 docker run -d --name mony-minio --restart unless-stopped \
#     -p 9010:9000 -p 9011:9001 -v mony-minio-data:/data \
#     -e MINIO_ROOT_USER=mony-dev -e MINIO_ROOT_PASSWORD=<root-secret> \
#     minio/minio server /data --console-address ":9001"
# Then, inside the container (docker exec mony-minio sh), create the private
# bucket and a least-privilege user for the API — never give the API the
# root login (its access key is visible in every signed URL):
#   mc alias set local http://127.0.0.1:9000 mony-dev <root-secret>
#   mc mb local/mony
#   mc admin policy create local mony-api policy.json   # Get/Put/DeleteObject on mony/*, ListBucket on mony
#   mc admin user add local mony-api <api-secret>
#   mc admin policy attach local mony-api --user mony-api
MINIO_ENDPOINT=http://localhost:9010
# Host the phone can reach for signed photo URLs (dev machine LAN IP); defaults to MINIO_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=http://192.168.0.10:9010
MINIO_ACCESS_KEY=mony-api
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=mony
# Dev-only convenience for the console/mc — never read by the API.
MINIO_DEV_ROOT_USER=mony-dev
MINIO_DEV_ROOT_PASSWORD=change-me-too
