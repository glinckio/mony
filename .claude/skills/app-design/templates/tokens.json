      "primaryMuted": "#164A44",
      "onPrimaryMuted": "#ABDFD6",
      "accent": "#FA7352",
      "onAccent": "#2A0A03",
      "success": "#4CBF86",
      "onSuccess": "#06240F",
      "warning": "#F5B942",
