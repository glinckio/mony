      "danger": "#F07167",
      "onDanger": "#2A0505",
      "overlay": "#000000B3",
      "placeholder": "#35302C"
    }
  },
  "typography": {
    "families": {
      "display": { "name": "Bricolage Grotesque", "source": "google", "weights": [600, 700] },
      "body": { "name": "Figtree", "source": "google", "weights": [400, 500, 600] }
    },
    "scale": {
      "display":    { "family": "display", "size": 34, "lineHeight": 40, "weight": 700, "letterSpacing": -0.5 },
      "title1":     { "family": "display", "size": 28, "lineHeight": 34, "weight": 700, "letterSpacing": -0.3 },
      "title2":     { "family": "display", "size": 22, "lineHeight": 28, "weight": 700, "letterSpacing": -0.2 },
      "title3":     { "family": "body", "size": 20, "lineHeight": 25, "weight": 600, "letterSpacing": 0 },
      "headline":   { "family": "body", "size": 17, "lineHeight": 22, "weight": 600, "letterSpacing": 0 },
      "body":       { "family": "body", "size": 16, "lineHeight": 24, "weight": 400, "letterSpacing": 0 },
      "bodyStrong": { "family": "body", "size": 16, "lineHeight": 24, "weight": 600, "letterSpacing": 0 },
      "callout":    { "family": "body", "size": 15, "lineHeight": 20, "weight": 400, "letterSpacing": 0 },
      "subhead":    { "family": "body", "size": 14, "lineHeight": 20, "weight": 500, "letterSpacing": 0 },
      "footnote":   { "family": "body", "size": 13, "lineHeight": 18, "weight": 400, "letterSpacing": 0 },
      "caption":    { "family": "body", "size": 12, "lineHeight": 16, "weight": 500, "letterSpacing": 0.2 },
      "label":      { "family": "body", "size": 15, "lineHeight": 20, "weight": 600, "letterSpacing": 0 }
    }
  },
  "spacing": { "none": 0, "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "2xl": 24, "3xl": 32, "4xl": 40, "5xl": 48, "6xl": 64 },
  "layout": { "screenPadding": 20, "touchTarget": 48, "maxContentWidth": 560 },
  "radius": { "none": 0, "sm": 6, "md": 12, "lg": 20, "xl": 28, "full": 999 },
  "elevation": {
    "sm": { "y": 1, "blur": 3, "opacity": 0.08, "android": 1 },
    "md": { "y": 4, "blur": 12, "opacity": 0.10, "android": 4 },
    "lg": { "y": 12, "blur": 28, "opacity": 0.14, "android": 10 }
  },
  "motion": {
    "duration": { "fast": 120, "base": 220, "slow": 360 },
    "easing": {
      "standard": [0.2, 0, 0, 1],
      "decelerate": [0.05, 0.7, 0.1, 1],
      "accelerate": [0.3, 0, 0.8, 0.15]
    },
    "spring": { "damping": 20, "stiffness": 220, "mass": 1 },
    "stagger": 40,
    "moment": 650,
    "ambientLoop": 14000,
    "vida": 2
  },
  "icon": { "library": "Phosphor", "style": "regular", "sizes": { "sm": 16, "md": 20, "lg": 24, "xl": 32 } },
  "contrastChecks": [
    { "fg": "textMuted", "bg": "surfaceMuted", "min": 4.5 },
    { "fg": "border", "bg": "background", "min": 1.2 }
  ]
}
