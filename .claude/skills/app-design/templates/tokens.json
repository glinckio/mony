{
  "meta": {
    "app": "Nome do App",
    "direcao": "Nome da direção de arte",
    "atualizado": "AAAA-MM-DD",
    "nota": "Exemplo preenchido: troque todos os valores. Mantenha as chaves semânticas de color.light/color.dark."
  },
  "color": {
    "palette": {
      "brand": {
        "50": "#EEF8F6", "100": "#D5EFEA", "200": "#ABDFD6", "300": "#78C8BB", "400": "#45AB9C",
        "500": "#268F81", "600": "#1B7368", "700": "#185C54", "800": "#164A44", "900": "#133D39", "950": "#082422"
      },
      "accent": {
        "50": "#FFF3EF", "100": "#FFE3DA", "200": "#FFC4B3", "300": "#FF9C83", "400": "#FA7352",
        "500": "#EE5533", "600": "#D63F1F", "700": "#B23219", "800": "#922B19", "900": "#78281A", "950": "#41110A"
      },
      "neutral": {
        "0": "#FFFFFF", "50": "#FAF8F6", "100": "#F2EFEB", "200": "#E4DFD9", "300": "#CFC8C0", "400": "#A89F95",
        "500": "#81776D", "600": "#645B52", "700": "#4D4640", "800": "#35302C", "900": "#221F1C", "950": "#151311"
      },
      "success": { "400": "#4CBF86", "600": "#1E7D4F" },
      "warning": { "300": "#F5B942", "400": "#E9A23B" },
      "danger": { "400": "#F07167", "600": "#C62F2F" }
    },
    "light": {
      "background": "#FAF8F6",
      "surface": "#FFFFFF",
      "surfaceMuted": "#F2EFEB",
      "surfaceElevated": "#FFFFFF",
      "border": "#E4DFD9",
      "text": "#221F1C",
      "textMuted": "#645B52",
      "primary": "#1B7368",
      "onPrimary": "#FFFFFF",
      "primaryMuted": "#D5EFEA",
      "onPrimaryMuted": "#164A44",
      "accent": "#D63F1F",
      "onAccent": "#FFFFFF",
      "success": "#1E7D4F",
      "onSuccess": "#FFFFFF",
      "warning": "#E9A23B",
      "onWarning": "#2B1B00",
      "danger": "#C62F2F",
      "onDanger": "#FFFFFF",
      "overlay": "#151311A6",
      "placeholder": "#E4DFD9"
    },
    "dark": {
      "background": "#151311",
      "surface": "#221F1C",
      "surfaceMuted": "#2B2724",
      "surfaceElevated": "#35302C",
      "border": "#4D4640",
      "text": "#F2EFEB",
